{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Field Notes",
  "version": "0.8.0",
  "identifier": "com.fieldnotes.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Field Notes",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/dosewiki.json",
      "resources/dosewiki-corpus.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENzc1MDQzMTg5M0MzOTEKUldTUnc1TVlRMUIzN2FaalJDcTB4YlF3WnNlNFo3VlgvWjZOcVYwWkxLcDhKOUM5TzJGeFRVVkQK",
      "endpoints": [
        "https://github.com/sparkly-quasar/field-notes/releases/latest/download/latest.json"
      ]
    }
  }
}
